<?xml version="1.0" encoding="utf-8"?>
<!-- Backup exclusion rules (B-5 / AppSec MEDIUM-3).
     The forecast cache, recent places, and preferences may hold
     location-adjacent data — exclude them from Auto Backup / cloud restore.
     Wire into AndroidManifest.xml:
       <application android:dataExtractionRules="@xml/data_extraction_rules" …> -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Hive boxes: forecast cache + recent places -->
        <exclude domain="file" path="forecast_cache.hive"/>
        <exclude domain="file" path="forecast_cache.lock"/>
        <exclude domain="file" path="recent_places.hive"/>
        <exclude domain="file" path="recent_places.lock"/>
        <!-- SharedPreferences: settings, consent state, saved place -->
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="forecast_cache.hive"/>
        <exclude domain="file" path="forecast_cache.lock"/>
        <exclude domain="file" path="recent_places.hive"/>
        <exclude domain="file" path="recent_places.lock"/>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
    </device-transfer>
</data-extraction-rules>
